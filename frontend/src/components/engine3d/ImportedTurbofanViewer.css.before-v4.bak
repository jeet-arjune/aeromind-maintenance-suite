.ait-root{border:1px solid #dce8f2;border-radius:14px;overflow:hidden;background:#fff;color:#183a56}
.ait-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 14px;border-bottom:1px solid #e4edf4;flex-wrap:wrap}
.ait-status{display:flex;align-items:center;gap:7px;color:#55758b;font-size:10px;letter-spacing:1px;font-weight:800}
.ait-status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#1683c0;box-shadow:0 0 0 3px #e3f2fb}
.ait-actions{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.ait-actions button{border:1px solid #dbe6ef;border-radius:7px;background:#fff;color:#305771;padding:7px 9px;display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;cursor:pointer}
.ait-actions button:hover,.ait-actions button[aria-pressed="true"]{background:#eaf5fc;border-color:#93c5e5;color:#0b78b5}
.ait-canvas{height:430px;position:relative;background:linear-gradient(#f6fbfe,#eaf3f9);touch-action:none}
.ait-canvas canvas{display:block;outline:none}
.ait-hint{position:absolute;left:13px;bottom:12px;display:flex;align-items:center;gap:6px;background:#ffffffdf;border:1px solid #e2edf4;border-radius:20px;padding:6px 10px;font-size:11px;color:#55758b;pointer-events:none}
.ait-footer{padding:13px 14px}
.ait-zone-list{display:flex;flex-wrap:wrap;gap:6px}
.ait-zone-list button{background:#f4f8fb;border:1px solid #dce8f2;border-radius:8px;padding:9px 10px;font-size:11px;color:#42637b;font-weight:700;cursor:pointer}
.ait-zone-list button:hover,.ait-zone-list button.ait-zone-active{background:#e5f3fc;color:#0878b7;border-color:#80bde1}
.ait-selection{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:12px;color:#5c7588;line-height:1.5}
.ait-selection strong{color:#173b58}
.ait-details{display:flex;flex-wrap:wrap;gap:12px;margin-top:10px;color:#5d788a;font-size:11px}
.ait-details span{display:inline-flex;align-items:center;gap:5px}
.ait-note{font-size:10px;line-height:1.6;color:#758b9b;margin:11px 0 0}
.ait-credit{font-size:10px;line-height:1.6;color:#61798a;margin:8px 0 0}
.ait-credit a{color:#0878b7;text-decoration:underline;text-underline-offset:2px}
.ait-sensor-tag,.ait-zone-tag{display:inline-block;white-space:nowrap;background:#0e3f60;color:#fff;border:1px solid #4db4e4;border-radius:7px;padding:5px 8px;font-size:12px;font-weight:800;box-shadow:0 4px 12px #163b5b30}
.ait-zone-tag{font-size:10px;background:#ffffffed;color:#16435e;border-color:#bad5e4}
.ait-loading{display:inline-block;background:#ffffffeb;color:#28516c;border:1px solid #dce8f2;border-radius:8px;padding:10px 13px;font-size:12px;font-weight:700;white-space:nowrap}
@media(max-width:650px){.ait-canvas{height:330px}.ait-actions button span{display:none}.ait-toolbar{gap:7px}.ait-hint{font-size:10px}}
